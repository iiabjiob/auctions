{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: api",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "ZAKUPKI_FETCH_GATEWAY_URL": "http://127.0.0.1:8080",
          "ZAKUPKI_FETCH_TOKEN": "dev-zakupki-fetch-token"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: zakupki fetcher",
      "type": "shell",
      "command": "uv run uvicorn app.zakupki_fetcher:app --host 0.0.0.0 --port 8080 --proxy-headers --forwarded-allow-ips=*",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "ZAKUPKI_FETCH_TOKEN": "dev-zakupki-fetch-token",
          "ZAKUPKI_FETCH_BASE_URL": "https://zakupki.gov.ru",
          "ZAKUPKI_FETCH_ALLOWED_HOSTS": "zakupki.gov.ru"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction sync worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_sync_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction analysis worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_analysis_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction enrichment worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_enrichment_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction actuality worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_actuality_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: telegram sender worker",
      "type": "shell",
      "command": "uv run python -m app.worker.telegram_sender_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: procurement sync worker",
      "type": "shell",
      "command": "uv run python -m app.worker.procurement_sync_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PROCUREMENT_SYNC_ENABLED": "true",
          "PROCUREMENT_SYNC_RUN_ON_START": "true",
          "ZAKUPKI_FETCH_GATEWAY_URL": "http://127.0.0.1:8080",
          "ZAKUPKI_FETCH_TOKEN": "dev-zakupki-fetch-token"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: procurement enrichment worker",
      "type": "shell",
      "command": "uv run python -m app.worker.procurement_enrichment_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PROCUREMENT_ENRICHMENT_ENABLED": "true",
          "ZAKUPKI_FETCH_GATEWAY_URL": "http://127.0.0.1:8080",
          "ZAKUPKI_FETCH_TOKEN": "dev-zakupki-fetch-token"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: procurement actuality worker",
      "type": "shell",
      "command": "uv run python -m app.worker.procurement_actuality_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend",
        "env": {
          "PROCUREMENT_ACTUALITY_SWEEP_ENABLED": "true"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: start all",
      "dependsOrder": "parallel",
      "dependsOn": [
        "backend: api",
        "backend: auction sync worker",
        "backend: auction analysis worker",
        "backend: auction enrichment worker",
        "backend: auction actuality worker",
        "backend: zakupki fetcher",
        "backend: procurement sync worker",
        "backend: procurement enrichment worker",
        "backend: procurement actuality worker",
        "backend: telegram sender worker"
      ],
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    }
  ]
}
