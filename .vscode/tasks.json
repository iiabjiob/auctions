{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "backend: migrate",
      "type": "shell",
      "command": "uv run alembic upgrade head",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: api",
      "type": "shell",
      "command": "uv run uvicorn app.main:app --reload --host 0.0.0.0 --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction sync worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_sync_worker",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "group": "backend",
        "panel": "dedicated",
        "reveal": "always"
      }
    },
    {
      "label": "backend: auction analysis worker",
      "type": "shell",
      "command": "uv run python -m app.worker.auction_analysis_worker",
