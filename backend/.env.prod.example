APP_VERSION=0.1.0
APP_NAME=Auctions
DESCRIPTION=Auctions - backend service
AUTHOR=Anton Pavlov

APP_ENV=production
DEBUG=false
DEBUG_LEVEL=INFO

AUTH_SECRET_KEY=change_me_prod_auth_secret
AUTH_TOKEN_TTL_MINUTES=10080
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DEFAULT_USER_ENABLED=true
DEFAULT_USER_NAME=Default User
DEFAULT_USER_EMAIL=demo@auctions.local
DEFAULT_USER_PASSWORD=change-me-demo

POSTGRES_HOST=db
POSTGRES_DB=auctions_pg
POSTGRES_USER=auctions_app
POSTGRES_PASSWORD=change_me_prod_strong_password
POSTGRES_PORT=5432
POSTGRES_HOST_AUTH_METHOD=md5

REDIS_URL=redis://redis:6379/0

AUCTION_EVENTS_STREAM=auction:events
AUCTION_SYNC_RUN_ON_START=False
AUCTION_SYNC_INTERVAL_SECONDS=300
AUCTION_SYNC_INTERVAL_JITTER_SECONDS=2700
AUCTION_SYNC_LIMIT=0
AUCTION_SYNC_COMMIT_CHUNK_SIZE=25
AUCTION_SYNC_PROGRESS_LOG_EVERY=25
AUCTION_DETAIL_SYNC_ENABLED=true
AUCTION_DETAIL_SYNC_LIMIT=25
AUCTION_PUBLICATION_SYNC_LIMIT=0
AUCTION_ANALYSIS_ENABLED=true
AUCTION_ANALYSIS_INTERVAL_SECONDS=1800
AUCTION_ANALYSIS_BATCH_SIZE=2000
AUCTION_ANALYSIS_COMMIT_CHUNK_SIZE=25
AUCTION_ANALYSIS_EVENT_CHUNK_SIZE=25
AUCTION_ANALYSIS_EVENT_PAUSE_SECONDS=0.1
AUCTION_ANALYSIS_USE_ACTIVE_SCORING_PROFILE=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_SENDER_DRY_RUN=True
TELEGRAM_SENDER_BATCH_LIMIT=20
TELEGRAM_SENDER_MAX_ATTEMPTS=3
TELEGRAM_SENDER_BASE_BACKOFF_SECONDS=60
TELEGRAM_SENDER_POLL_INTERVAL_SECONDS=60
TELEGRAM_SENDER_REQUEST_TIMEOUT_SECONDS=10.0
GRID_CHANGE_FEED_LIMIT=1000
GRID_CHANGE_FEED_MAX_LIMIT=1000

TBANKROT_AUTH_ENABLED=false
TBANKROT_LOGIN=
TBANKROT_PASSWORD=
TBANKROT_PAGES=3
TBANKROT_INCLUDE_PRICE_SCHEDULE=true
TBANKROT_REQUEST_MIN_DELAY_SECONDS=2.5
TBANKROT_REQUEST_MAX_DELAY_SECONDS=7.0
TBANKROT_BLOCKED_COOLDOWN_SECONDS=21600
